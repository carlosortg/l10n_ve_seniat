<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_l10n_ve" model="ir.ui.view">
        <field name="name">res.partner.form.l10n.ve</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="l10n_ve_rif"
                       invisible="country_id and country_id.code != 'VE'"/>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page string="Fiscal Venezuela" name="l10n_ve_fiscal"
                      invisible="country_id and country_id.code != 'VE'">
                    <group>
                        <group string="Identificacion Fiscal">
                            <field name="l10n_ve_rif"/>
                            <field name="l10n_ve_taxpayer_type"/>
                            <field name="l10n_ve_is_special_taxpayer" readonly="1"/>
                            <field name="l10n_ve_is_retention_agent"/>
                        </group>
                        <group string="Ubicacion Fiscal">
                            <field name="l10n_ve_municipality_id" options="{'no_create': True}"/>
                            <field name="l10n_ve_parish"/>
                            <field name="l10n_ve_economic_activity"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_partner_tree_l10n_ve" model="ir.ui.view">
        <field name="name">res.partner.tree.l10n.ve</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="l10n_ve_rif" optional="show"/>
                <field name="l10n_ve_taxpayer_type" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
