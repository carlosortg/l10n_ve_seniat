<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ut_list" model="ir.ui.view">
        <field name="name">l10n.ve.ut.list</field>
        <field name="model">l10n.ve.unidad.tributaria</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="amount"/>
                <field name="date_from"/>
                <field name="date_to"/>
            </list>
        </field>
    </record>
    <record id="view_ut_form" model="ir.ui.view">
        <field name="name">l10n.ve.ut.form</field>
        <field name="model">l10n.ve.unidad.tributaria</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="amount"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ut" model="ir.actions.act_window">
        <field name="name">Unidad Tributaria</field>
        <field name="res_model">l10n.ve.unidad.tributaria</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
