<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_igtf" model="ir.ui.view">
        <field name="name">res.config.settings.igtf</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="IGTF Venezuela">
                    <setting string="Porcentaje IGTF">
                        <field name="l10n_ve_igtf_rate"/>
                        <field name="l10n_ve_igtf_account_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
