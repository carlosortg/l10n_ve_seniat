<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_igtf" model="ir.ui.view">
        <field name="name">res.company.form.igtf</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="IGTF">
                    <group>
                        <field name="l10n_ve_igtf_rate"/>
                        <field name="l10n_ve_igtf_account_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
