<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_form_ve_bank" model="ir.ui.view">
        <field name="name">account.payment.form.ve.bank</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Odoo 19: no hay field name="ref" en el form estandar -->
            <xpath expr="//field[@name='amount']" position="after">
                <field name="l10n_ve_payment_channel"/>
                <field name="l10n_ve_payment_reference"/>
            </xpath>
        </field>
    </record>
</odoo>
