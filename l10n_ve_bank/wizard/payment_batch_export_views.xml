<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_batch_export_form" model="ir.ui.view">
        <field name="name">l10n.ve.payment.batch.export.form</field>
        <field name="model">l10n.ve.payment.batch.export</field>
        <field name="arch" type="xml">
            <form>
                <group invisible="state == 'done'">
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <group invisible="state != 'done'">
                    <field name="file_name" invisible="1"/>
                    <field name="file_data" filename="file_name"/>
                </group>
                <field name="state" invisible="1"/>
                <footer>
                    <button name="action_generate" string="Generar" type="object" class="btn-primary" invisible="state == 'done'"/>
                    <button string="Cerrar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_payment_batch_export" model="ir.actions.act_window">
        <field name="name">Exportar pagos masivos</field>
        <field name="res_model">l10n.ve.payment.batch.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
