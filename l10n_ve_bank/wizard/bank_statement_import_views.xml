<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_statement_import_form" model="ir.ui.view">
        <field name="name">l10n.ve.bank.statement.import.form</field>
        <field name="model">l10n.ve.bank.statement.import</field>
        <field name="arch" type="xml">
            <form string="Importar extracto CSV">
                <group>
                    <field name="journal_id"/>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="delimiter"/>
                    <field name="has_header"/>
                </group>
                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_bank_statement_import_ve" model="ir.actions.act_window">
        <field name="name">Importar extracto CSV</field>
        <field name="res_model">l10n.ve.bank.statement.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
