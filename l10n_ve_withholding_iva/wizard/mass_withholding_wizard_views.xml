<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mass_withholding_wizard_form" model="ir.ui.view">
        <field name="name">l10n.ve.mass.withholding.wizard.form</field>
        <field name="model">l10n.ve.mass.withholding.wizard</field>
        <field name="arch" type="xml">
            <form string="Retenciones IVA masivas">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="rate"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_mass_withholding_wizard" model="ir.actions.act_window">
        <field name="name">Retenciones IVA masivas</field>
        <field name="res_model">l10n.ve.mass.withholding.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_mass_withholding" name="Retenciones IVA masivas"
              parent="l10n_ve_withholding.menu_l10n_ve_withholding_root"
              action="action_mass_withholding_wizard" sequence="20"/>
</odoo>
