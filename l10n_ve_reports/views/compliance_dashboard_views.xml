<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_compliance_dashboard_form" model="ir.ui.view">
        <field name="name">l10n.ve.compliance.dashboard.form</field>
        <field name="model">l10n.ve.compliance.dashboard</field>
        <field name="arch" type="xml">
            <form string="Cumplimiento fiscal VE">
                <sheet>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="sale_invoices"/>
                        <field name="sale_without_control"/>
                        <field name="iva_withholdings_draft"/>
                    </group>
                    <field name="notes"/>
                </sheet>
                <footer>
                    <button name="action_refresh" string="Actualizar" type="object" class="btn-primary"/>
                    <button string="Cerrar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_compliance_dashboard" model="ir.actions.act_window">
        <field name="name">Cumplimiento fiscal VE</field>
        <field name="res_model">l10n.ve.compliance.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
