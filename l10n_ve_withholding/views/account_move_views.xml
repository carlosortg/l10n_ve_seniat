<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_ve_withholding" model="ir.ui.view">
        <field name="name">account.move.form.l10n.ve.withholding</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_withholdings" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                        invisible="l10n_ve_withholding_count == 0">
                    <field name="l10n_ve_withholding_count" widget="statinfo" string="Retenciones"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Retenciones sufridas (VE)" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="l10n_ve_suffered_iva"/>
                    <field name="l10n_ve_suffered_islr"/>
                    <field name="l10n_ve_suffered_voucher"/>
                    <field name="l10n_ve_suffered_move_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
