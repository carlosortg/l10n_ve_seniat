<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_withholding" model="ir.actions.report">
        <field name="name">Comprobante de retencion</field>
        <field name="model">account.withholding</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ve_withholding.report_withholding_document</field>
        <field name="report_file">l10n_ve_withholding.report_withholding_document</field>
        <field name="binding_model_id" ref="model_account_withholding"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_withholding_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Comprobante de retencion <span t-field="o.withholding_type"/></h2>
                        <p><strong>Numero:</strong> <span t-field="o.name"/></p>
                        <p><strong>Fecha:</strong> <span t-field="o.date"/></p>
                        <p><strong>Sujeto:</strong> <span t-field="o.partner_id"/></p>
                        <p><strong>Base:</strong> <span t-field="o.amount_base"/></p>
                        <p><strong>Retenido:</strong> <span t-field="o.amount_withheld"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
