<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fiscal_book_wizard_form" model="ir.ui.view">
        <field name="name">l10n.ve.fiscal.book.wizard.form</field>
        <field name="model">l10n.ve.fiscal.book.wizard</field>
        <field name="arch" type="xml">
            <form string="Libro fiscal">
                <group>
                    <field name="book_type"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generar libro" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_fiscal_book_wizard" model="ir.actions.act_window">
        <field name="name">Libros fiscales SENIAT</field>
        <field name="res_model">l10n.ve.fiscal.book.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
