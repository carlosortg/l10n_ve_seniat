<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bcv_rate_list" model="ir.ui.view">
        <field name="name">l10n.ve.bcv.rate.list</field>
        <field name="model">l10n.ve.bcv.rate</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="currency_id"/>
                <field name="rate"/>
                <field name="source"/>
                <field name="currency_rate_id"/>
            </list>
        </field>
    </record>
    <record id="view_bcv_rate_form" model="ir.ui.view">
        <field name="name">l10n.ve.bcv.rate.form</field>
        <field name="model">l10n.ve.bcv.rate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply_to_odoo_rate" string="Aplicar a tasas Odoo" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="currency_id"/>
                        <field name="rate"/>
                        <field name="source"/>
                        <field name="name"/>
                        <field name="currency_rate_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bcv_rate" model="ir.actions.act_window">
        <field name="name">Historico tasas BCV</field>
        <field name="res_model">l10n.ve.bcv.rate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
