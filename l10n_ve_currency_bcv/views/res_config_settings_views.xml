<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bcv" model="ir.ui.view">
        <field name="name">res.config.settings.bcv</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Tasa BCV">
                    <setting string="URL fuente">
                        <field name="l10n_ve_bcv_rate_url"/>
                        <field name="l10n_ve_bcv_auto_fetch"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
