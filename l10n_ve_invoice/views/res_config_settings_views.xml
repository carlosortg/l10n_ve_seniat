<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_l10n_ve_invoice" model="ir.ui.view">
        <field name="name">res.config.settings.l10n.ve.invoice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Facturacion fiscal Venezuela">
                    <setting string="Secuencia numero de control">
                        <field name="l10n_ve_control_number_sequence_id"/>
                    </setting>
                    <setting string="Bloquear documentos con N de control">
                        <field name="l10n_ve_lock_control_number"/>
                    </setting>
                    <setting string="NC exige documento origen">
                        <field name="l10n_ve_require_nc_origin"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
