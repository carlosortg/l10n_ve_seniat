<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_ve_invoice" model="ir.ui.view">
        <field name="name">account.move.form.l10n.ve.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="l10n_ve_control_number" readonly="1"/>
                <field name="l10n_ve_invoice_number"/>
                <field name="l10n_ve_origin_move_id"
                       invisible="move_type not in ('out_refund', 'in_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
