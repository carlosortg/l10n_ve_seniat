<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_ve_invoice" model="ir.ui.view">
        <field name="name">account.move.form.l10n.ve.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='title']" position="after">
                <group invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')">
                    <group string="Fiscal Venezuela">
                        <field name="l10n_ve_document_type" readonly="1"/>
                        <field name="l10n_ve_control_number" readonly="1"/>
                        <field name="l10n_ve_invoice_number"/>
                        <field name="l10n_ve_origin_move_id"
                               invisible="move_type not in ('out_refund','in_refund')"/>
                        <field name="l10n_ve_requires_control" invisible="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_l10n_ve_control" model="ir.ui.view">
        <field name="name">account.move.list.l10n.ve.control</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_ve_control_number" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
